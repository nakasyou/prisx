# サーバー設定は prisx.config.ts（または PRISX_CONFIG で指定したパス）を優先します。
# prisx.config.ts が無い場合のフォールバック値です。
PORT=3100
HOST=127.0.0.1
APP_URL=http://localhost:3100
DATA_DIR=data
# BETTER_AUTH_SECRET=replace-with-a-long-random-secret
MAX_UPLOAD_BYTES=104857600
OBJECT_STORAGE=file
# OBJECT_STORAGE=s3
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=prisx
# S3_PREFIX=prisx/
# S3_PATH_STYLE=true
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=